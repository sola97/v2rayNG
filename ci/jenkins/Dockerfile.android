# syntax=docker/dockerfile:1.7

FROM eclipse-temurin:17-jdk-jammy@sha256:61a9a7bd265855cb9ebdd396f5925b16dbdde01feb9b97a87f7f6008fc39c2b4 AS builder

ARG GO_VERSION=1.26.0
ARG GO_SHA256=aac1b08a0fb0c4e0a7c1555beb7b59180b05dfc5a3d62e40e9de90cd42f88235
ARG ANDROID_COMMAND_LINE_TOOLS_VERSION=14742923
ARG ANDROID_COMMAND_LINE_TOOLS_SHA1=48833c34b761c10cb20bcd16582129395d121b27
ARG ANDROID_PLATFORM_PACKAGE=37.0
ARG ANDROID_BUILD_TOOLS=37.0.0
ARG ANDROID_NDK_VERSION=29.0.14206865
ARG GOMOBILE_VERSION=v0.0.0-20260709172247-6129f5bee9d5
ARG BUILD_FDROID=true
ARG BUILD_PLAYSTORE=false

ENV ANDROID_HOME=/opt/android-sdk \
    ANDROID_SDK_ROOT=/opt/android-sdk \
    ANDROID_NDK_HOME=/opt/android-sdk/ndk/29.0.14206865 \
    GOPATH=/go \
    GOMAXPROCS=1 \
    GOFLAGS=-p=1 \
    PATH=/usr/local/go/bin:/go/bin:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:${PATH}

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        make \
        unzip \
        zip \
    && rm -rf /var/lib/apt/lists/*

RUN curl --fail --location --retry 4 \
        "https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz" \
        --output /tmp/go.tar.gz \
    && echo "${GO_SHA256}  /tmp/go.tar.gz" | sha256sum --check --strict \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz \
    && go version

RUN mkdir -p "${ANDROID_HOME}/cmdline-tools" \
    && curl --fail --location --retry 4 \
        "https://dl.google.com/android/repository/commandlinetools-linux-${ANDROID_COMMAND_LINE_TOOLS_VERSION}_latest.zip" \
        --output /tmp/android-command-line-tools.zip \
    && echo "${ANDROID_COMMAND_LINE_TOOLS_SHA1}  /tmp/android-command-line-tools.zip" | sha1sum --check --strict \
    && unzip -q /tmp/android-command-line-tools.zip -d /tmp/android-command-line-tools \
    && mv /tmp/android-command-line-tools/cmdline-tools "${ANDROID_HOME}/cmdline-tools/latest" \
    && rm -rf /tmp/android-command-line-tools /tmp/android-command-line-tools.zip \
    && sdkmanager --version

RUN yes | sdkmanager --licenses >/dev/null

RUN installed=false \
    && for attempt in 1 2 3 4; do \
        if sdkmanager \
            "platform-tools" \
            "platforms;android-${ANDROID_PLATFORM_PACKAGE}" \
            "build-tools;${ANDROID_BUILD_TOOLS}"; then \
            installed=true; \
            break; \
        fi; \
        echo "Android SDK package installation attempt ${attempt} failed" >&2; \
        sleep $((attempt * 5)); \
    done \
    && test "${installed}" = true \
    && sdkmanager --list_installed

RUN installed=false \
    && for attempt in 1 2 3 4; do \
        if sdkmanager "ndk;${ANDROID_NDK_VERSION}"; then \
            installed=true; \
            break; \
        fi; \
        echo "Android NDK installation attempt ${attempt} failed" >&2; \
        sleep $((attempt * 5)); \
    done \
    && test "${installed}" = true \
    && sdkmanager --list_installed

RUN --mount=type=cache,id=v2rayng-naive-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=v2rayng-naive-go-build,target=/root/.cache/go-build \
    go install "golang.org/x/mobile/cmd/gomobile@${GOMOBILE_VERSION}" \
    && gomobile init

WORKDIR /src/xray
COPY xray/ ./

RUN --mount=type=cache,id=v2rayng-naive-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=v2rayng-naive-go-build,target=/root/.cache/go-build \
    go test -tags with_purego ./proxy/naive \
    && go test -tags with_purego ./infra/conf -run '^TestNaive' \
    && go test -tags with_purego ./common/singbridge ./proxy/shadowsocks_2022

RUN --mount=type=cache,id=v2rayng-naive-go-mod,target=/go/pkg/mod \
    set -eu \
    && for module_root in \
        /go/pkg/mod/github.com/sagernet/cronet-go/lib \
        /go/pkg/mod/cache/download/github.com/sagernet/cronet-go/lib; do \
        if test -d "${module_root}"; then \
            find "${module_root}" \
                -mindepth 1 \
                -maxdepth 1 \
                -type d \
                ! -name 'android_*' \
                -exec rm -rf -- {} +; \
        fi; \
    done \
    && find /go/pkg/mod/github.com/sagernet/cronet-go \
        -mindepth 1 \
        -maxdepth 1 \
        -type d \
        -name 'all@*' \
        -exec rm -rf -- {} + \
    && rm -rf -- /go/pkg/mod/cache/download/github.com/sagernet/cronet-go/all

WORKDIR /src/androidlib
COPY androidlib/ ./

RUN mkdir -p assets data /out \
    && bash gen_assets.sh download \
    && test -s data/geoip.dat \
    && test -s data/geosite.dat \
    && test -s data/geoip-only-cn-private.dat \
    && cp -v data/*.dat assets/

RUN --mount=type=cache,id=v2rayng-naive-go-mod,target=/go/pkg/mod \
    --mount=type=cache,id=v2rayng-naive-go-build,target=/root/.cache/go-build \
    gomobile bind \
        -v \
        -androidapi 24 \
        -trimpath \
        -ldflags='-s -w -buildid= -checklinkname=0' \
        -o /out/libv2ray.aar \
        ./ \
    && test -s /out/libv2ray.aar

WORKDIR /src/v2rayng
COPY v2rayng/ ./

RUN mkdir -p V2rayNG/app/libs /out/apk /out/test-results /out/test-reports \
    && cp /out/libv2ray.aar V2rayNG/app/libs/libv2ray.aar

WORKDIR /src/v2rayng/V2rayNG

RUN --mount=type=cache,id=v2rayng-naive-gradle-user-home,target=/root/.gradle,sharing=locked \
    set -eu \
    && tasks='testFdroidDebugUnitTest' \
    && if test "${BUILD_FDROID}" = 'true'; then tasks="${tasks} assembleFdroidDebug"; fi \
    && if test "${BUILD_PLAYSTORE}" = 'true'; then tasks="${tasks} assemblePlaystoreDebug"; fi \
    && ./gradlew \
        --no-daemon \
        --stacktrace \
        --max-workers=1 \
        -Dorg.gradle.jvmargs='-Xmx1536m -Dfile.encoding=UTF-8' \
        -Pkotlin.compiler.execution.strategy=in-process \
        ${tasks} \
    && find app/build/test-results/testFdroidDebugUnitTest -type f -name '*.xml' \
        -exec cp -v {} /out/test-results/ \; \
    && cp -R app/build/reports/tests/testFdroidDebugUnitTest/. /out/test-reports/ \
    && if test "${BUILD_FDROID}" = 'true'; then \
        find app/build/outputs/apk/fdroid/debug -maxdepth 1 -type f -name '*.apk' \
            -exec cp -v {} /out/apk/ \;; \
    fi \
    && if test "${BUILD_PLAYSTORE}" = 'true'; then \
        find app/build/outputs/apk/playstore/debug -maxdepth 1 -type f -name '*.apk' \
            -exec cp -v {} /out/apk/ \;; \
    fi \
    && test -n "$(find /out/test-results -type f -name '*.xml' -print -quit)" \
    && if test "${BUILD_FDROID}" = 'true' || test "${BUILD_PLAYSTORE}" = 'true'; then \
        test -n "$(find /out/apk -type f -name '*.apk' -print -quit)"; \
    fi

FROM scratch AS artifact
COPY --from=builder /out/ /
